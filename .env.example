# Copy to .env and fill in. Never commit .env.

# LLM provider (only "openai" is implemented so far) and model
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini
LLM_REASONING_EFFORT=low
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# YouTube Data API v3
YOUTUBE_API_KEY=

# Langfuse tracing (leave empty to disable tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Paths
RAW_RECIPES_CSV=data/raw/RAW_recipes.csv
DB_PATH=data/processed/pantry.db
CHROMA_PATH=data/processed/chroma

# Logging
LOG_LEVEL=INFO
