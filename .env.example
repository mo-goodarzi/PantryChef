# Copy to .env and fill in. Never commit .env.

# LLM provider: "anthropic" or "openai"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# YouTube Data API v3
YOUTUBE_API_KEY=

# Langfuse tracing (leave empty to disable tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Paths
RAW_RECIPES_CSV=data/raw/RAW_recipes.csv
RAW_INTERACTIONS_CSV=data/raw/RAW_interactions.csv
IRKAAL_RECIPES_PARQUET=data/raw/recipes.parquet
DB_PATH=data/processed/pantry.db
CHROMA_PATH=data/processed/chroma

# Logging
LOG_LEVEL=INFO
