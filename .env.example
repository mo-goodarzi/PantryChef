# Copy to .env and fill in. Never commit .env.

# LLM provider (only "openai" is implemented so far) and model
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini
ALLERGY_REVIEW_MODEL=gpt-5.4-mini
HIDDEN_ALLERGEN_MODEL=gpt-5.4-mini
LABEL_MODEL=gpt-5.4-mini
WISH_FIT_MODEL=gpt-5.4-mini
JUDGE_MODEL=gpt-5.4-mini
WISH_FIT_ENABLED=true
LLM_REASONING_EFFORT=low
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# YouTube Data API v3 (optional: without it the app never offers a video)
YOUTUBE_API_KEY=
VIDEO_MODEL=gpt-5.4-mini

# Langfuse tracing (leave empty to disable tracing). Put real keys only in .env, which is
# git-ignored: this file is public (tests/test_config.py fails if a key has a value).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Paths
RAW_RECIPES_CSV=data/raw/RAW_recipes.csv
RAW_INTERACTIONS_CSV=data/raw/RAW_interactions.csv
DB_PATH=data/processed/pantry.db
STATE_DB_PATH=data/processed/state.db
CHROMA_PATH=data/processed/chroma

# Conversation: ask how much of key ingredients the user has (off until Phase 8)
QUANTITY_QUESTION=when_it_matters  # off | when_it_matters | always

# Logging
LOG_LEVEL=INFO
